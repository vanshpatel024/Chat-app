# Firebase Configuration for Quick Chat
# Obtain these values from your Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your_firebase_api_key_here

# In production on Vercel: set to chat-app-psi-seven-47.vercel.app (first-party auth proxy domain)
# For local development: set to your_project_id.firebaseapp.com or chat-app-psi-seven-47.vercel.app
VITE_FIREBASE_AUTH_DOMAIN=chat-app-psi-seven-47.vercel.app

VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_firebase_measurement_id
