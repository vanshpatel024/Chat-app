{
  "buildCommand": "npm --prefix chat-app run build",
  "outputDirectory": "chat-app/dist",
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://chat-app-6a105.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
